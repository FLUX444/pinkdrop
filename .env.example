# Server
PORT=3001
# VK требует https — для локальной разработки: USE_HTTPS=true + npm run certs:dev
USE_HTTPS=false
API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173
# Публичный URL сайта (для sitemap, canonical, Open Graph)
PUBLIC_FRONTEND_URL=https://pinkdrop.ru
# Google Search Console — код подтверждения домена (мета-тег в index.html)
VITE_GOOGLE_SITE_VERIFICATION=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false
SESSION_DAYS=30

# Google OAuth — https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# VK ID — https://id.vk.com/about/business/go/docs/ru/vkid/latest/vk-id/connection/create-application
# Базовый домен в кабинете VK: localhost
# Redirect URL: https://localhost:3001/api/auth/vk/callback (при USE_HTTPS=true)
VK_CLIENT_ID=
VK_REDIRECT_URI=https://localhost:3001/api/auth/vk/callback

# Telegram — бот PINKDROP (папка BOT TG): каталог, корзина, поддержка, пополнения
# Секреты здесь. Остальные настройки бота — в config/pinkdrop.yaml
# Создайте бота через @BotFather, добавьте его админом в канал пополнений
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
BOT_API_SECRET=pinkdrop_bot_local_secret
# Chat ID администратора для уведомлений о закончившихся товарах (узнать: @userinfobot)
TELEGRAM_ADMIN_CHAT_ID=
# Канал ops: логи мониторинга, heartbeat, алерты (или telegram.ops_channel.id в pinkdrop.yaml)
TELEGRAM_OPS_CHAT_ID=-1003999192222
# Канал поддержки: уведомления PINKDROP // SUPPORT (или telegram.support_channel.id в pinkdrop.yaml)
TELEGRAM_SUPPORT_CHANNEL_ID=-1003924177661
# Поддержка — лучше задать в config/pinkdrop.yaml (telegram.support.contact_user_id)
TELEGRAM_SUPPORT_USERNAME=
TELEGRAM_SUPPORT_USER_ID=

# SMS.ru — https://sms.ru/ (если пусто, код показывается в dev-режиме)
SMSRU_API_ID=
SMS_DEV_EXPOSE_CODE=true

# Email — коды, уведомления, письма от админа
# Быстрее всего: Resend (https://resend.com) + подтверждённый домен pinkdrop.ru
# RESEND_API_KEY=re_...
# EMAIL_FROM=PINKDROP <noreply@pinkdrop.ru>
# EMAIL_REPLY_TO=support@pinkdrop.ru
#
# Или SMTP вашего хостинга/почты домена (не Gmail — он медленнее и чаще попадает в спам):
# SMTP_HOST=smtp.pinkdrop.ru
# SMTP_PORT=465
# SMTP_USER=noreply@pinkdrop.ru
# SMTP_PASS=...
# EMAIL_FROM=PINKDROP <noreply@pinkdrop.ru>
# EMAIL_REPLY_TO=support@pinkdrop.ru
#
# Gmail (для разработки; отправитель будет через Gmail, не noreply@pinkdrop.ru):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_google_app_password
EMAIL_FROM=PINKDROP <noreply@pinkdrop.ru>
EMAIL_REPLY_TO=your@gmail.com
EMAIL_SEND_TIMEOUT_MS=15000
SMTP_POOL_MAX_CONNECTIONS=3
EMAIL_DEV_EXPOSE_CODE=false

# Admin panel — пароль только в .env, в БД не хранится
ADMIN_PASSWORD=admin123
# Кто видит плашку «Админ-функции» в личном кабинете (через запятую)
ADMIN_ALLOWED_EMAILS=you@gmail.com
# Telegram user id операторов (узнать: @userinfobot)
ADMIN_ALLOWED_TELEGRAM_IDS=

# AES-256 ключ для шифрования адресов (64 hex-символа = 32 байта)
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Безопасность (для продакшена)
STRICT_ORIGIN_CHECK=false
ALLOW_LOCALHOST_CORS=true
COOKIE_SECURE=true
RATE_LIMIT_GENERAL=120
RATE_LIMIT_AUTH=20
RATE_LIMIT_ADMIN_LOGIN=5
RATE_LIMIT_ORDERS=10
